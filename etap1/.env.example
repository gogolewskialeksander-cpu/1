# ===== AliExpress Dropshipping API =====
# Uzyskaj na https://openservice.aliexpress.com/
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
# Callback URL wpisany w panelu aplikacji AliExpress
ALIEXPRESS_REDIRECT_URI=https://callback.megasklep.pl

# ===== Anthropic Claude API =====
# Uzyskaj na https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== BaseLinker API =====
# Uzyskaj w panelu BaseLinker: Moje konto -> API
BASELINKER_API_TOKEN=
# ID katalogu BaseLinker do ktorego dodajemy produkty (opcjonalne)
BASELINKER_INVENTORY_ID=
# ID magazynu BaseLinker — format "bl_XXXXXX" (prefix bl_ dodawany automatycznie)
BASELINKER_STORAGE_ID=bl_1

# ===== Filtry i parametry biznesowe =====
SHIP_FROM_COUNTRIES=PL,CZ,DE,ES,FR
TARGET_CURRENCY=PLN
TARGET_LANGUAGE=pl
MIN_SELLER_RATING=4.5
MIN_STOCK=5
MARGIN_TARGET_PERCENT=30
MAX_PRODUCTS_PER_RUN=100
MIN_POTENTIAL_SCORE=6
MAX_DELIVERY_DAYS=10
